    "@types/jasmine": "~5.1.0",
    "@types/ngeohash": "^0.6.8",
    "@types/wrap-ansi": "^8.0.2",
    "aws-cdk": "^2.137.0",
    "aws-cdk-lib": "^2.137.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.20.2",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "json-schema-to-ts": "^3.1.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
